// Dealbox MVP - Prisma Schema
// Local Restaurant Discount & Coupon Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum for coupon status
enum CouponStatus {
  UNUSED
  USED
  EXPIRED
}

// Enum for session user type
enum UserType {
  CUSTOMER
  RESTAURANT
  ADMIN
}

// Customers - identified by phone number only
model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  referralCode String?  @unique @map("referral_code")
  referredBy   String?  @map("referred_by")
  createdAt    DateTime @default(now()) @map("created_at")

  coupons           Coupon[]
  favorites         Favorite[]
  referrals         Referral[] @relation("ReferrerRelation")
  visitHistory      VisitHistory[]
  pushSubscriptions PushSubscription[]
  reviews           Review[]

  @@map("users")
}

// Restaurant partners
model Restaurant {
  id              String   @id @default(uuid())
  name            String
  area            String
  cuisine         String?
  description     String?
  address         String?
  phone           String?
  menuUrl         String?  @map("menu_url")
  username        String   @unique
  passwordHash    String   @map("password_hash")
  isActive        Boolean  @default(true) @map("is_active")
  offPeakBoost    Boolean  @default(false) @map("off_peak_boost")
  commissionRate  Float    @default(10.0) @map("commission_rate")
  avgRating       Float    @default(0) @map("avg_rating")
  totalReviews    Int      @default(0) @map("total_reviews")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  offer           Offer?
  coupons         Coupon[]
  favorites       Favorite[]
  commissions     Commission[]
  visitHistory    VisitHistory[]
  photos          RestaurantPhoto[]
  reviews         Review[]
  scheduledOffers ScheduledOffer[]

  @@index([area, isActive])
  @@index([offPeakBoost, isActive])
  @@index([avgRating])
  @@map("restaurants")
}

// One active offer per restaurant (MVP simplification)
model Offer {
  id           String   @id @default(uuid())
  restaurantId String   @unique @map("restaurant_id")
  offerText    String   @map("offer_text")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coupons    Coupon[]

  @@map("offers")
}

// Single-use coupons with 3-hour expiry
model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  userId       String       @map("user_id")
  restaurantId String       @map("restaurant_id")
  offerId      String       @map("offer_id")
  status       CouponStatus @default(UNUSED)
  createdAt    DateTime     @default(now()) @map("created_at")
  expiresAt    DateTime     @map("expires_at")
  redeemedAt   DateTime?    @map("redeemed_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  offer      Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("coupons")
}

// Admin users (single super-admin for MVP)
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// Sessions table for all user types (polymorphic reference)
// user_id is NOT a real FK - we use userType to determine which table to look up
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userType  UserType @map("user_type")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// OTP codes for phone verification
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@index([expiresAt])
  @@map("otp_codes")
}

// User favorites - save favorite restaurants
model Favorite {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  restaurantId String   @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@map("favorites")
}

// Referral tracking
model Referral {
  id           String   @id @default(uuid())
  referrerId   String   @map("referrer_id")
  referredId   String   @map("referred_id")
  bonusAwarded Boolean  @default(false) @map("bonus_awarded")
  createdAt    DateTime @default(now()) @map("created_at")

  referrer User @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referredId])
  @@index([referrerId])
  @@map("referrals")
}

// Commission tracking for manual billing
model Commission {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  couponId     String   @map("coupon_id")
  amount       Float
  isPaid       Boolean  @default(false) @map("is_paid")
  paidAt       DateTime? @map("paid_at")
  billingMonth String   @map("billing_month")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, billingMonth])
  @@index([isPaid])
  @@map("commissions")
}

// Visit history for recently visited restaurants
model VisitHistory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  restaurantId String   @map("restaurant_id")
  visitedAt    DateTime @default(now()) @map("visited_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([userId, visitedAt])
  @@index([restaurantId])
  @@map("visit_history")
}

// Push notification subscriptions for web push
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Restaurant photos gallery
model RestaurantPhoto {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  url          String
  caption      String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, sortOrder])
  @@map("restaurant_photos")
}

// Customer reviews for restaurants
model Review {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  userId       String   @map("user_id")
  rating       Int      // 1-5 stars
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([restaurantId, createdAt])
  @@index([rating])
  @@map("reviews")
}

// Scheduled offers for real-time offer scheduling
model ScheduledOffer {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  offerText    String   @map("offer_text")
  startTime    DateTime @map("start_time")
  endTime      DateTime @map("end_time")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, startTime, endTime])
  @@index([isActive, startTime, endTime])
  @@map("scheduled_offers")
}
