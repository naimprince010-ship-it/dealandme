// Dealbox MVP - Prisma Schema
// Local Restaurant Discount & Coupon Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enum for coupon status
enum CouponStatus {
  UNUSED
  USED
  EXPIRED
}

// Enum for session user type
enum UserType {
  CUSTOMER
  RESTAURANT
  ADMIN
}

// Enum for discount type
enum DiscountType {
  PERCENTAGE
  FLAT
}

// Enum for what the offer applies to
enum OfferAppliesTo {
  TOTAL_BILL
  SELECTED_ITEMS
  DINE_IN_ONLY
  TAKEAWAY_ONLY
  FIRST_ORDER
  OTHER
}

// Customers - identified by phone number only
model User {
  id           String    @id @default(uuid())
  phone        String    @unique
  name         String?
  email        String?
  referralCode String?   @unique @map("referral_code")
  referredBy   String?   @map("referred_by")
  photoUrl     String?   @map("photo_url")
  lastActiveAt DateTime? @map("last_active_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  coupons           Coupon[]
  favorites         Favorite[]
  referrals         Referral[] @relation("ReferrerRelation")
  visitHistory      VisitHistory[]
  pushSubscriptions PushSubscription[]
  userBadges        UserBadge[]

  @@index([lastActiveAt])
  @@map("users")
}

// Restaurant partners
model Restaurant {
  id              String    @id @default(uuid())
  name            String
  area            String
  cuisine         String?
  description     String?
  coverImage      String?   @map("cover_image")
  username        String    @unique
  passwordHash    String    @map("password_hash")
  isActive        Boolean   @default(true) @map("is_active")
  offPeakBoost    Boolean   @default(false) @map("off_peak_boost")
  commissionRate  Float     @default(10.0) @map("commission_rate")
  paymentOverdue  Boolean   @default(false) @map("payment_overdue")
  trialEndDate    DateTime? @map("trial_end_date")
  lastActiveAt    DateTime? @map("last_active_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Home screen display flags (admin-managed)
  isPopular          Boolean @default(false) @map("is_popular")
  popularSortOrder   Int?    @map("popular_sort_order")
  latitude           Float?
  longitude          Float?

  offer          Offer?
  coupons        Coupon[]
  favorites      Favorite[]
  commissions    Commission[]
  visitHistory   VisitHistory[]
  invoices       Invoice[]
  homeCategories HomeCategoryRestaurant[]

  @@index([area, isActive])
  @@index([offPeakBoost, isActive])
  @@index([paymentOverdue])
  @@index([isPopular, popularSortOrder])
  @@index([lastActiveAt])
  @@map("restaurants")
}

// One active offer per restaurant (MVP simplification)
model Offer {
  id           String   @id @default(uuid())
  restaurantId String   @unique @map("restaurant_id")
  offerText    String   @map("offer_text")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // New structured fields for offer management refinement
  discountType      DiscountType? @map("discount_type")
  discountValue     Float?        @map("discount_value")
  maxDiscountAmount Float?        @map("max_discount_amount")
  title             String?
  description       String?
  terms             String?
  photoUrl          String?       @map("photo_url")

  // What the offer applies to
  appliesTo         OfferAppliesTo? @map("applies_to")

  // Home screen featured deals (admin-managed)
  isFeatured        Boolean @default(false) @map("is_featured")
  featuredSortOrder Int?    @map("featured_sort_order")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  coupons    Coupon[]

  @@index([isFeatured, featuredSortOrder])
  @@map("offers")
}

// Single-use coupons with 3-hour expiry
model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  userId       String       @map("user_id")
  restaurantId String       @map("restaurant_id")
  offerId      String       @map("offer_id")
  status       CouponStatus @default(UNUSED)
  createdAt    DateTime     @default(now()) @map("created_at")
  expiresAt    DateTime     @map("expires_at")
  redeemedAt   DateTime?    @map("redeemed_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  offer      Offer      @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("coupons")
}

// Admin users (single super-admin for MVP)
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// Sessions table for all user types (polymorphic reference)
// user_id is NOT a real FK - we use userType to determine which table to look up
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userType  UserType @map("user_type")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

// OTP codes for phone verification
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime @map("expires_at")
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@index([expiresAt])
  @@map("otp_codes")
}

// User favorites - save favorite restaurants
model Favorite {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  restaurantId String   @map("restaurant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([userId])
  @@map("favorites")
}

// Referral tracking
model Referral {
  id           String   @id @default(uuid())
  referrerId   String   @map("referrer_id")
  referredId   String   @map("referred_id")
  bonusAwarded Boolean  @default(false) @map("bonus_awarded")
  createdAt    DateTime @default(now()) @map("created_at")

  referrer User @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referredId])
  @@index([referrerId])
  @@map("referrals")
}

// Commission tracking for manual billing
model Commission {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  couponId     String   @map("coupon_id")
  amount       Float
  isPaid       Boolean  @default(false) @map("is_paid")
  paidAt       DateTime? @map("paid_at")
  billingMonth String   @map("billing_month")
  invoiceId    String?  @map("invoice_id")
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invoice    Invoice?   @relation(fields: [invoiceId], references: [id])

  @@index([restaurantId, billingMonth])
  @@index([isPaid])
  @@index([invoiceId])
  @@map("commissions")
}

// Invoice status enum
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

// Monthly invoices for restaurants
model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  restaurantId    String        @map("restaurant_id")
  billingMonth    String        @map("billing_month")
  totalAmount     Float         @map("total_amount")
  totalCoupons    Int           @map("total_coupons")
  commissionRate  Float         @map("commission_rate")
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime      @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  paymentMethod   String?       @map("payment_method")
  transactionId   String?       @map("transaction_id")
  pdfUrl          String?       @map("pdf_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@unique([restaurantId, billingMonth])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

// Visit history for recently visited restaurants
model VisitHistory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  restaurantId String   @map("restaurant_id")
  visitedAt    DateTime @default(now()) @map("visited_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([userId, visitedAt])
  @@index([restaurantId])
  @@map("visit_history")
}

// Push notification subscriptions for web push
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Areas for restaurant location filtering
model Area {
  id        String   @id @default(uuid())
  nameEn    String   @map("name_en")
  nameBn    String   @map("name_bn")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([nameEn])
  @@index([isActive, sortOrder])
  @@map("areas")
}

// Home screen categories (Near Me, Buffet, Cafe, etc.)
model HomeCategory {
  id        String   @id @default(uuid())
  key       String   @unique
  labelEn   String   @map("label_en")
  labelBn   String   @map("label_bn")
  iconKey   String   @map("icon_key")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurants HomeCategoryRestaurant[]

  @@index([isActive, sortOrder])
  @@map("home_categories")
}

// Join table: which restaurants appear in which category
model HomeCategoryRestaurant {
  id           String   @id @default(uuid())
  categoryId   String   @map("category_id")
  restaurantId String   @map("restaurant_id")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  category   HomeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([categoryId, restaurantId])
  @@index([categoryId, sortOrder])
  @@map("home_category_restaurants")
}

// Badge criteria type enum
enum BadgeCriteriaType {
  COUPONS_USED
  COUPONS_GENERATED
  RESTAURANTS_VISITED
  REFERRALS
}

// Badges for gamification (admin-controlled)
model Badge {
  id           String            @id @default(uuid())
  key          String            @unique
  nameEn       String            @map("name_en")
  nameBn       String            @map("name_bn")
  description  String?
  icon         String
  criteriaType BadgeCriteriaType @map("criteria_type")
  threshold    Int
  sortOrder    Int               @default(0) @map("sort_order")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  userBadges UserBadge[]

  @@index([isActive, sortOrder])
  @@map("badges")
}

// User badge unlocks (tracks when a user unlocked a badge)
model UserBadge {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  badgeId    String   @map("badge_id")
  unlockedAt DateTime @default(now()) @map("unlocked_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// App install type enum
enum AppType {
  CUSTOMER
  RESTAURANT
}

// PWA app install tracking
model AppInstall {
  id         String   @id @default(uuid())
  installId  String   @unique @map("install_id")
  appType    AppType  @map("app_type")
  userId     String?  @map("user_id")
  userAgent  String?  @map("user_agent")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([appType])
  @@index([lastSeenAt])
  @@map("app_installs")
}
